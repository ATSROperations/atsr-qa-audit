# systemd service: keeps the app running and restarts it after crashes or reboots.
# Install: sudo cp deploy/atsr-qa-audit.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now atsr-qa-audit
[Unit]
Description=ATSR B2B QA Audit
After=network.target

[Service]
Type=simple
User=atsrqa
Group=atsrqa
WorkingDirectory=/opt/atsr-qa-audit/app
EnvironmentFile=/etc/atsr-qa-audit.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/server.mjs
Restart=always
RestartSec=3

# Hardening: the app can read its code and write only to its data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atsr-qa-audit
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
