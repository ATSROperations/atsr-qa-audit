# Copy to /etc/atsr-qa-audit.env (owner root, chmod 600). Read by the systemd service.
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/atsr-qa-audit
# Same value as the AUTH_PEPPER secret on Cloudflare, so existing passwords keep working.
# If nobody has it, set a new long random value and import with --skip-users.
AUTH_PEPPER=
# One-time password for the owner's first sign-in on an empty database.
OWNER_INITIAL_PASSWORD=
OWNER_EMAIL=operations@atsrpl.com.au
